# Em Roboflow > Models, clique em Copy Model ID. Copie o ID completo workspace/modelo.
# Exemplo com slug mostrado na avaliação; substitua SEU_WORKSPACE pelo valor real:
ROBOFLOW_MODEL_ID=SEU_WORKSPACE/cards-ksgh0-2-rfdetr-small-t1
# Chave privada: mantenha apenas neste arquivo local (NUNCA no frontend ou no GitHub).
ROBOFLOW_API_KEY=sua-chave-privada
PORT=3001
# Opcional: caminho de um JSON com nomes de classes personalizados
# ROBOFLOW_CLASS_MAP=./server/class-map.example.json
